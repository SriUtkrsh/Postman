							"  pm.expect(responseData.booking).to.have.property('bookingdates').that.is.an('object');",
							"  pm.expect(responseData.booking.bookingdates).to.have.property('checkin').that.is.a('string').and.to.not.be.empty;",
							"  pm.expect(responseData.booking.bookingdates).to.have.property('checkout').that.is.a('string').and.to.not.be.empty;",
